{
  "name": "ai-daily-intelligence",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @ai-daily/web dev",
    "build": "pnpm --filter @ai-daily/importer build && pnpm --filter @ai-daily/web build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "node supabase/tests/verify-foundation.mjs && pnpm -r --if-present test"
  }
}
