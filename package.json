{
  "name": "ai-daily-intelligence",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @ai-daily/web dev",
    "build": "pnpm --filter @ai-daily/importer build && pnpm --filter @ai-daily/web build",
    "lint": "pnpm --filter @ai-daily/web lint",
    "typecheck": "pnpm --filter @ai-daily/importer typecheck && pnpm --filter @ai-daily/web typecheck",
    "test": "node supabase/tests/verify-foundation.mjs && pnpm --filter @ai-daily/importer test && pnpm --filter @ai-daily/web test"
  }
}
