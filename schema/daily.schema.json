{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Alliesy/ai-daily-intelligence/schema/daily.schema.json",
  "title": "AI Daily Intelligence Daily Packet",
  "type": "object",
  "required": ["schema_version", "date_kst", "generated_at", "status", "news", "business_ideas", "tools", "community", "skill_of_the_day", "worth_reading", "todays_insight", "build_candidate"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "date_kst": {"type": "string", "format": "date"},
    "generated_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["complete", "partial"]},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "news": {"type": "array", "minItems": 3, "maxItems": 5, "items": {"$ref": "#/$defs/news"}},
    "business_ideas": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/idea"}, "allOf": [{"contains": {"type": "object", "properties": {"today_eligible": {"const": true}}, "required": ["today_eligible"]}, "minContains": 0, "maxContains": 1}]},
    "tools": {"type": "array", "maxItems": 4, "items": {"$ref": "#/$defs/tool"}},
    "community": {"type": "array", "maxItems": 5, "items": {"$ref": "#/$defs/community"}},
    "skill_of_the_day": {"$ref": "#/$defs/skill"},
    "worth_reading": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/bookmark"}, "allOf": [{"contains": {"properties": {"type": {"const": "Paper"}}, "required": ["type"]}}, {"contains": {"properties": {"type": {"const": "GitHub"}}, "required": ["type"]}}, {"contains": {"properties": {"type": {"const": "YouTube"}}, "required": ["type"]}}, {"contains": {"properties": {"type": {"const": "Blog"}}, "required": ["type"]}}]},
    "todays_insight": {"type": "string", "minLength": 10},
    "morning_paper": {"$ref": "#/$defs/morning_paper"},
    "build_candidate": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/candidate"}]}
  },
  "$defs": {
    "source": {"type": "object", "required": ["title", "url", "publisher", "published_at", "tier"], "properties": {"title": {"type": "string"}, "url": {"type": "string", "format": "uri"}, "publisher": {"type": "string"}, "published_at": {"type": "string"}, "tier": {"enum": ["A", "B", "C"]}, "source_type": {"enum": ["official_blog", "article", "youtube", "x", "github", "paper", "documentation", "reddit", "hackernews", "other"]}, "authority": {"enum": ["official", "primary", "independent", "analysis", "community", "unknown"]}, "verification_status": {"enum": ["verified", "corroborated", "unverified", "disputed"]}, "evidence_group": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}}},
    "news": {"type": "object", "required": ["event_key", "title", "importance", "one_line_summary", "impact", "original_url", "key_quote", "quote_translation", "summary", "why_it_matters", "industry_mood", "outlook", "business_opportunity", "tags", "sources"], "properties": {"event_key": {"type": "string"}, "title": {"type": "string"}, "importance": {"enum": ["S", "A", "B"]}, "one_line_summary": {"type": "string"}, "impact": {"type": "string"}, "original_url": {"type": "string", "format": "uri"}, "key_quote": {"type": "string"}, "quote_translation": {"type": "string"}, "summary": {"type": "string"}, "why_it_matters": {"type": "string"}, "industry_mood": {"type": "object"}, "outlook": {"type": "string"}, "business_opportunity": {"type": "string"}, "tags": {"type": "array", "items": {"type": "string"}}, "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}}}},
    "idea": {"type": "object", "required": ["name", "score", "stars", "potential", "difficulty", "customer", "problem", "competitors", "differentiation", "mvp_2_weeks", "monetization", "falsification"], "properties": {"name": {"type": "string"}, "score": {"type": "number", "minimum": 0, "maximum": 5}, "stars": {"type": "integer", "minimum": 1, "maximum": 5}, "potential": {"enum": ["Low", "Medium", "High", "Very High"]}, "difficulty": {"type": "string"}, "customer": {"type": "string"}, "problem": {"type": "string"}, "competitors": {"type": "array", "items": {"type": "string"}}, "differentiation": {"type": "string"}, "mvp_2_weeks": {"type": "string"}, "monetization": {"type": "string"}, "falsification": {"type": "string"}, "problem_evidence": {"type": "array", "items": {"$ref": "#/$defs/problem_evidence"}}, "realism_gates": {"$ref": "#/$defs/realism_gates"}, "today_eligible": {"type": "boolean"}, "eligibility_method": {"const": "opportunity_gate_v1"}}, "allOf": [{"if": {"properties": {"today_eligible": {"const": true}}, "required": ["today_eligible"]}, "then": {"required": ["problem_evidence", "realism_gates", "eligibility_method"], "properties": {"problem_evidence": {"minItems": 1}, "eligibility_method": {"const": "opportunity_gate_v1"}, "realism_gates": {"properties": {"customer": {"$ref": "#/$defs/passing_gate"}, "pain": {"$ref": "#/$defs/passing_gate"}, "existing_solution": {"$ref": "#/$defs/passing_gate"}, "technology_change": {"$ref": "#/$defs/passing_gate"}, "buildability": {"$ref": "#/$defs/passing_gate"}, "mvp": {"$ref": "#/$defs/passing_gate"}, "customer_access": {"$ref": "#/$defs/passing_gate"}, "replacement_risk": {"$ref": "#/$defs/passing_gate"}, "dependency": {"$ref": "#/$defs/passing_gate"}}}}}}]},
    "morning_paper": {"type": "object", "required": ["insight_headline", "insight_summary", "insight_method", "evidence_event_keys", "top_event_keys"], "properties": {"insight_headline": {"type": "string", "minLength": 1}, "insight_summary": {"type": "string", "minLength": 1}, "insight_method": {"const": "cross_event_signal_v1"}, "evidence_event_keys": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "top_event_keys": {"type": "array", "maxItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}},
    "problem_evidence": {"type": "object", "required": ["url", "source_type", "summary"], "properties": {"url": {"type": "string", "format": "uri"}, "source_type": {"enum": ["official_blog", "article", "youtube", "x", "github", "paper", "documentation", "reddit", "hackernews", "other"]}, "summary": {"type": "string", "minLength": 1}, "observed_at": {"type": "string"}, "evidence_group": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}}},
    "gate_result": {"type": "object", "required": ["status", "evidence"], "properties": {"status": {"enum": ["pass", "fail", "unknown"]}, "evidence": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "passing_gate": {"type": "object", "required": ["status", "evidence"], "properties": {"status": {"const": "pass"}, "evidence": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "realism_gates": {"type": "object", "required": ["customer", "pain", "existing_solution", "technology_change", "buildability", "mvp", "customer_access", "replacement_risk", "dependency"], "properties": {"customer": {"$ref": "#/$defs/gate_result"}, "pain": {"$ref": "#/$defs/gate_result"}, "existing_solution": {"$ref": "#/$defs/gate_result"}, "technology_change": {"$ref": "#/$defs/gate_result"}, "buildability": {"$ref": "#/$defs/gate_result"}, "mvp": {"$ref": "#/$defs/gate_result"}, "customer_access": {"$ref": "#/$defs/gate_result"}, "replacement_risk": {"$ref": "#/$defs/gate_result"}, "dependency": {"$ref": "#/$defs/gate_result"}}, "additionalProperties": false},
    "tool": {"type": "object", "required": ["name", "type", "url", "stars", "why_trending", "worth_trying"], "properties": {"name": {"type": "string"}, "type": {"type": "string"}, "url": {"type": "string", "format": "uri"}, "stars": {"type": "integer", "minimum": 1, "maximum": 5}, "why_trending": {"type": "string"}, "worth_trying": {"type": "string"}}},
    "community": {"type": "object", "required": ["platform", "mood", "one_line_summary", "url"], "properties": {"platform": {"enum": ["Hacker News", "Reddit", "X", "Product Hunt", "GitHub", "Other"]}, "mood": {"type": "string"}, "one_line_summary": {"type": "string"}, "url": {"type": "string", "format": "uri"}}},
    "skill": {"type": "object", "required": ["name", "when_to_use", "practical_example", "prompt_example"], "properties": {"name": {"type": "string"}, "when_to_use": {"type": "string"}, "practical_example": {"type": "string"}, "prompt_example": {"type": "string"}}},
    "bookmark": {"type": "object", "required": ["type", "title", "url", "why_read"], "properties": {"type": {"enum": ["Paper", "GitHub", "YouTube", "Blog"]}, "title": {"type": "string"}, "url": {"type": "string", "format": "uri"}, "why_read": {"type": "string"}}},
    "candidate": {"type": "object", "required": ["idea_name", "score", "owner_action_required", "status", "evidence_urls"], "properties": {"idea_name": {"type": "string"}, "score": {"type": "number", "minimum": 4.3, "maximum": 5}, "owner_action_required": {"const": true}, "status": {"const": "waiting_for_owner"}, "evidence_urls": {"type": "array", "minItems": 2, "items": {"type": "string", "format": "uri"}}}}
  }
}
