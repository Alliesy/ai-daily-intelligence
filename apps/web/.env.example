# Public browser-safe values only. Never put SUPABASE_SERVICE_ROLE_KEY in the web app.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Use "supabase" in deployed environments and "archive" for credential-free preview builds.
CONTENT_SOURCE=archive

# Server-only read credential for Vercel Web Analytics. Never prefix with NEXT_PUBLIC_.
VERCEL_ANALYTICS_READ_TOKEN=
VERCEL_ANALYTICS_PROJECT_ID=
# Optional for a team-owned Vercel project.
VERCEL_ANALYTICS_TEAM_ID=
